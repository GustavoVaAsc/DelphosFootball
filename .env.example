# Copy to .env (gitignored) and uncomment a line to override its default.
# Real environment variables take precedence over values in .env.
# A .env is read at or above the working directory, stopping at the project root's parent.

# -----------------------------------------------------------------------------
# Data and ML Pipeline Configuration
# -----------------------------------------------------------------------------

# Directory that holds the pipeline stage outputs (data/<stage>/).
# Relative paths resolve against the project root (the directory containing uv.lock),
# and ~ expands to the home directory. Outside the project (for example in a container without
# uv.lock), set an absolute path.
# DELPHOS_DATA_DIR=data

# Kaggle dataset handle, owner/slug, without a version.
# DELPHOS_KAGGLE_DATASET=davidcariboo/player-scores

# Pinned Kaggle dataset version. Changing it is a deliberate data refresh.
# DELPHOS_KAGGLE_DATASET_VERSION=679

# Model run ID for artifacts and publication (defaults to timestamped run slug)
# DELPHOS_MODEL_RUN_ID=

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------

# Database host and port
# DELPHOS_DB_HOST=localhost
# DELPHOS_DB_PORT=5432
# DELPHOS_DB_NAME=delphos

# Superuser / Administrator (used for bootstrap and migration runners)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres_secret
# POSTGRES_DB=delphos

# Pipeline role (owns analytics schema, writes analytics only)
# DELPHOS_DB_USER=delphos_ml_publisher
# DELPHOS_DB_PASSWORD=delphos_ml_publisher_secret

# Application API role (reads analytics, owns and writes app schema)
# DELPHOS_APP_DB_USER=delphos_app_user
# DELPHOS_APP_DB_PASSWORD=delphos_app_user_secret

# Optional explicit connection URLs
# DELPHOS_DATABASE_URL=postgresql://delphos_ml_publisher:delphos_ml_publisher_secret@localhost:5432/delphos
# DELPHOS_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres_secret@localhost:5432/delphos
# DELPHOS_APP_DATABASE_URL=postgresql+psycopg://delphos_app_user:delphos_app_user_secret@localhost:5432/delphos

# -----------------------------------------------------------------------------
# Backend API & Deployment Configuration
# -----------------------------------------------------------------------------

# FastAPI backend port
# DELPHOS_API_PORT=8000

# CORS allowed origins (comma-separated list)
# DELPHOS_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# LLM inference service URL (OpenAI-compatible).
# The default is the compose service name and only resolves inside the compose
# network. A local run started from backend/ (see backend/AGENTS.md) must point
# at the host instead: DELPHOS_LLM_API_URL=http://localhost:8080/v1
# DELPHOS_LLM_API_URL=http://inference-chat:8080/v1

# Every DELPHOS_LLM_* key below is read by the backend from its own environment.
# The compose backend service forwards only DELPHOS_LLM_API_URL and
# DELPHOS_LLM_MODEL_NAME to the container, so the remaining keys take their code
# defaults in the compose deployment; they apply when the backend runs outside
# compose (see backend/AGENTS.md).

# Model id sent in the LLM request body.
# It MUST equal the id the inference server serves, which is the LLAMA_ARG_ALIAS
# of the inference-chat service; docker-compose.yml derives that alias from
# this same variable, so overriding it here keeps both sides in sync.
# Verify with: curl http://inference-chat:8080/v1/models -> the returned "id"
# must equal the id the backend sends.
# DELPHOS_LLM_MODEL_NAME=qwen/qwen3.5-9b

# Per-request LLM timeout in seconds
# DELPHOS_LLM_TIMEOUT_SECONDS=120.0

# Chat completion token cap
# DELPHOS_LLM_MAX_TOKENS=512

# Report completion token cap
# DELPHOS_LLM_REPORT_MAX_TOKENS=1400

# Sampling temperature
# DELPHOS_LLM_TEMPERATURE=0.7

# Nucleus sampling threshold
# DELPHOS_LLM_TOP_P=0.8

# Top-k sampling cutoff
# DELPHOS_LLM_TOP_K=20

# Repetition penalty
# DELPHOS_LLM_PRESENCE_PENALTY=0.0

# Whether the model reasons before answering (sent per request)
# DELPHOS_LLM_ENABLE_THINKING=false

# Server context size, mirrored for the backend budget arithmetic
# DELPHOS_LLM_CONTEXT_SIZE=32768

# Chat tool-loop iteration cap
# DELPHOS_LLM_MAX_TOOL_ITERATIONS=4

# Cap on the chat path's concurrent LLM calls. It must not exceed the inference
# server's parallel slots (LLAMA_ARG_N_PARALLEL, 4 in docker-compose.yml), so a
# burst of chat requests queues instead of saturating the GPU.
# NOTE: the compose backend service does not forward this key, so it has NO
# effect in the compose deployment — the cap is the default 4, which matches the
# server's slot count. It applies when the backend runs outside compose; to tune
# it there, add the key to the backend service's environment block.
# DELPHOS_LLM_MAX_CONCURRENT_LLM_CALLS=4

# Chat history cap in turns
# DELPHOS_LLM_CHAT_HISTORY_TURNS=8

# Report provenance string (prompt version and sampling configuration).
# Recorded with every generated report; changing it invalidates the report cache.
# DELPHOS_LLM_REPORT_PROMPT_VERSION=v1-t0.7-p0.8-k20

# -----------------------------------------------------------------------------
# Inference Server Configuration (docker-compose.yml)
# -----------------------------------------------------------------------------

# Model file served by the inference-chat service, inside the mounted ./llms/models
# directory. Override it to run the CPU variant of the model (LLM_PLAN 6.1).
# LLAMA_ARG_MODEL=/models/Qwen3.5-9B-Q5_K_M.gguf

# Image tag of the llama.cpp server the inference-chat service runs. The default
# is the CUDA build; override it with "server" to run the CPU build on a host
# without a GPU, with the same compose file.
# LLAMA_ARG_IMAGE=server-cuda

# The id the inference server reports for the loaded model. It is derived from
# DELPHOS_LLM_MODEL_NAME by docker-compose.yml; set that variable instead of
# this one, so the id the backend sends and the id the server serves cannot
# drift apart.
# LLAMA_ARG_ALIAS=qwen/qwen3.5-9b
