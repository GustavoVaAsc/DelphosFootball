# Copy to .env (gitignored) and uncomment a line to override its default.
# Real environment variables take precedence over values in .env.
# A .env is read at or above the working directory, stopping at the project root's parent.

# -----------------------------------------------------------------------------
# Data and ML Pipeline Configuration
# -----------------------------------------------------------------------------

# Directory that holds the pipeline stage outputs (data/<stage>/).
# Relative paths resolve against the project root (the directory containing uv.lock),
# and ~ expands to the home directory. Outside the project (for example in a container without
# uv.lock), set an absolute path.
# DELPHOS_DATA_DIR=data

# Kaggle dataset handle, owner/slug, without a version.
# DELPHOS_KAGGLE_DATASET=davidcariboo/player-scores

# Pinned Kaggle dataset version. Changing it is a deliberate data refresh.
# DELPHOS_KAGGLE_DATASET_VERSION=679

# Model run ID for artifacts and publication (defaults to timestamped run slug)
# DELPHOS_MODEL_RUN_ID=

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------

# Database host and port
# DELPHOS_DB_HOST=localhost
# DELPHOS_DB_PORT=5432
# DELPHOS_DB_NAME=delphos

# Superuser / Administrator (used for bootstrap and migration runners)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres_secret
# POSTGRES_DB=delphos

# Pipeline role (owns analytics schema, writes analytics only)
# DELPHOS_DB_USER=delphos_ml_publisher
# DELPHOS_DB_PASSWORD=delphos_ml_publisher_secret

# Application API role (reads analytics, owns and writes app schema)
# DELPHOS_APP_DB_USER=delphos_app_user
# DELPHOS_APP_DB_PASSWORD=delphos_app_user_secret

# Optional explicit connection URLs
# DELPHOS_DATABASE_URL=postgresql://delphos_ml_publisher:delphos_ml_publisher_secret@localhost:5432/delphos
# DELPHOS_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres_secret@localhost:5432/delphos
# DELPHOS_APP_DATABASE_URL=postgresql+psycopg://delphos_app_user:delphos_app_user_secret@localhost:5432/delphos

# -----------------------------------------------------------------------------
# Backend API & Deployment Configuration
# -----------------------------------------------------------------------------

# FastAPI backend port
# DELPHOS_API_PORT=8000

# CORS allowed origins (comma-separated list)
# DELPHOS_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# LLM inference service URL (OpenAI-compatible)
# DELPHOS_LLM_API_URL=http://inference-chat:8080/v1
