# Copy to backend/.env (gitignored) to configure a local run started from backend/.
#
# The backend reads the .env file in its working directory, and backend/AGENTS.md
# documents running the dev server from backend/, so the repository-root .env is
# NOT read by a local run. Copy this file to backend/.env for that case.
#
# Inside docker compose none of this is needed: the backend service receives
# DELPHOS_LLM_API_URL, DELPHOS_LLM_MODEL_NAME and the fallback keys from the
# compose file.

# Base URL of the llama.cpp OpenAI-compatible API. The shipped default
# (http://inference-chat:8080/v1) is the compose service name and only resolves
# inside the compose network; from the host the server is on the published
# address and port (DELPHOS_INFERENCE_PUBLISH_IP / _PORT in the repository-root
# .env, default 127.0.0.1:8081).
# Use http://localhost:8081/v1 only when the published address is 127.0.0.1;
# when it is a specific interface address (the ZeroTier one), use that address:
# a published port binds to it only, and the host's loopback does not serve it.
# DELPHOS_LLM_API_URL=http://localhost:8081/v1

# Model id sent in the request body. It must equal the id the inference server
# serves (the LLAMA_ARG_ALIAS of the inference-chat service).
DELPHOS_LLM_MODEL_NAME=qwen/qwen3.5-9b

# Second inference endpoint, reached over ZeroTier, used when the primary one
# is unreachable. An empty URL disables the fallback: the backend then calls
# only the primary. The URL is the base of the OpenAI-compatible API of the
# PEER machine, e.g. http://10.147.85.4:8081/v1 for a peer that publishes its
# port there.
# The rules are an ALLOWLIST, not a syntax check:
#   - the host must be an IP LITERAL inside DELPHOS_LLM_FALLBACK_PEER_CIDR; a
#     hostname is refused, because it could resolve anywhere and DNS would
#     defeat the allowlist;
#   - loopback, link-local, unspecified, multicast and reserved addresses are
#     refused whatever the range says;
#   - no userinfo, no query string, no fragment and no whitespace; an invalid
#     value stops the backend at startup with a message naming this variable.
# The peer is PROBED before it is given anything: a dead or wrong address never
# receives a prompt.
# The host should be a DIFFERENT machine than this one: pointing it at this
# host's own published address is only a second path to the same process, so
# when the container is down the fallback is down too and the feature buys no
# availability. The backend warns when it sees that.
# The honest limit: a WRONG address INSIDE the allowed range still passes the
# check. What stops that case is the probe and the ZeroTier ACL pinning the
# published port to the peer.
# DELPHOS_LLM_FALLBACK_API_URL=http://10.147.85.4:8081/v1

# Model id sent to the fallback endpoint. Empty means "the same model as
# DELPHOS_LLM_MODEL_NAME", and that is the id the peer must report: the check
# is strict in both cases, so a peer serving another model is REFUSED and its
# prose is never stored as the club's model output. Set it only when the peer
# really serves a different model.
# DELPHOS_LLM_FALLBACK_MODEL_NAME=

# Timeout of a call to the fallback endpoint, in seconds.
# DELPHOS_LLM_FALLBACK_TIMEOUT_SECONDS=60.0

# Timeout of the reachability probe the backend makes against an endpoint
# before a call, in seconds. The endpoint counts as serving only when it
# answers HTTP 200 with a model list, and the verdict is cached for a few
# seconds. The fallback is probed with the same timeout before it is given
# anything.
# DELPHOS_LLM_PRIMARY_PROBE_SECONDS=5.0

# The range the peer's address must sit in. The backend refuses a fallback
# whose address is outside it, so a public host or an address of another
# network cannot receive the club's prompts. It must not be empty while a
# fallback URL is set: without it there is no allowlist. The default is the
# whole RFC1918 10/8 block, the range ZeroTier managed networks usually sit
# in: narrow it to the peer's actual subnet. A wrong address inside the range
# still passes this check — the probe and the ZeroTier ACL are what stop that
# case.
# DELPHOS_LLM_FALLBACK_PEER_CIDR=10.0.0.0/8

# The address THIS host publishes its inference server on (the repository-root
# .env sets it). The backend reads it to warn about a fallback that names this
# host's own published address: that fallback is a second path to the same
# process and provides no availability guarantee.
# DELPHOS_INFERENCE_PUBLISH_IP=

# Report provenance string (prompt version and sampling configuration).
# Recorded with every generated report; changing it invalidates the report cache.
# The revision is v2 since the prompt now names the fact keys the draft may
# cite (LLM_PLAN §7.3).
# DELPHOS_LLM_REPORT_PROMPT_VERSION=v2-t0.7-p0.8-k20

# Local database (the compose stack publishes PostgreSQL on this port)
# DELPHOS_DB_HOST=localhost
# DELPHOS_DB_PORT=5432
# DELPHOS_DB_NAME=delphos
# DELPHOS_APP_DB_USER=delphos_app_user
# DELPHOS_APP_DB_PASSWORD=delphos_app_user_secret
