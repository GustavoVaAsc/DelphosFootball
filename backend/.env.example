# Copy to backend/.env (gitignored) to configure a local run started from backend/.
#
# The backend reads the .env file in its working directory, and backend/AGENTS.md
# documents running the dev server from backend/, so the repository-root .env is
# NOT read by a local run. Copy this file to backend/.env for that case.
#
# Inside docker compose none of this is needed: the backend service receives
# DELPHOS_LLM_API_URL and DELPHOS_LLM_MODEL_NAME from the compose file.

# Base URL of the llama.cpp OpenAI-compatible API. The shipped default
# (http://inference-chat:8080/v1) is the compose service name and only resolves
# inside the compose network; from the host the server is on localhost.
DELPHOS_LLM_API_URL=http://localhost:8080/v1

# Model id sent in the request body. It must equal the id the inference server
# serves (the LLAMA_ARG_ALIAS of the inference-chat service).
DELPHOS_LLM_MODEL_NAME=qwen/qwen3.5-9b

# Local database (the compose stack publishes PostgreSQL on this port)
# DELPHOS_DB_HOST=localhost
# DELPHOS_DB_PORT=5432
# DELPHOS_DB_NAME=delphos
# DELPHOS_APP_DB_USER=delphos_app_user
# DELPHOS_APP_DB_PASSWORD=delphos_app_user_secret
