# Serves the Flutter web build (ARCHITECTURE.md §8). The nginx image renders
# this template into /etc/nginx/conf.d/default.conf at start-up with
# envsubst; only defined environment variables are replaced, so nginx's own
# $uri stays as it is.
#
# Caching: the build's file names carry no content hash (main.dart.js,
# flutter_bootstrap.js and the assets keep their names across builds), so
# every build file is revalidated with no-cache. Only CanvasKit and the
# bundled fonts are cached as immutable, because they change only with a
# Flutter SDK or font bump; after such a bump, change their path or clear
# the browser cache (frontend/AGENTS.md).
#
# add_header in a location replaces the server's add_header set, so every
# location that sets Cache-Control includes the security headers again.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    # ^~ stops the regex location below from matching these prefixes.
    location ^~ /canvaskit/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /assets/assets/fonts/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # A file with an extension is served as itself or is a real 404.
    location ~* \.[a-z0-9]+$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Any other path is an app route (/explorador?...): the router reads it
    # from index.html.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
